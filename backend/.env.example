# Sao chép file này thành `.env` rồi điền giá trị. `.env` đã nằm trong .gitignore.

# --- AI (không bắt buộc) ---------------------------------------------------
# Dán API key từ Google AI Studio (https://aistudio.google.com) vào đây để bật tạo thực đơn bằng AI.
# Keyword chuẩn từ Google AI Studio: GEMINI_API_KEY (hoặc GOOGLE_API_KEY).
# Để trống: BE vẫn chạy và tạo thực đơn theo quy tắc từ công thức có sẵn.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
AI_MODEL=gemini-3.5-flash
# Phải nhỏ hơn timeout 45 giây phía app.
AI_TIMEOUT_SECONDS=40

# --- Bảo mật (bắt buộc) ----------------------------------------------------
# Chuỗi ngẫu nhiên ít nhất 32 ký tự. Tạo bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_DAYS=7

# --- Không bắt buộc --------------------------------------------------------
# Mặc định lưu ở backend/data/bepviet.db
# DATABASE_URL=sqlite:///./data/bepviet.db
# Mặc định chỉ cho phép web chạy trên localhost gọi API.
# CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
