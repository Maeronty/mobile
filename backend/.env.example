# Sao chép thành `.env` rồi điền giá trị. `.env` đã nằm trong .gitignore.

PORT=8787
DATABASE_URL=sqlite://food_tip.db?mode=rwc

# Chuỗi ngẫu nhiên dài. Tạo bằng: openssl rand -base64 48
# LƯU Ý: nếu bỏ trống, src/config.rs đang dùng một secret mặc định ghi cứng trong code.
JWT_SECRET=
JWT_EXPIRATION_HOURS=2

# --- AI (không bắt buộc; thiếu thì /api/Ai/* trả 503) ---------------------
# Key từ https://aistudio.google.com, nhiều key cách nhau dấu phẩy (hoặc 1 key GEMINI_API_KEY).
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash
# Key từ https://spoonacular.com/food-api, dùng cho /api/Ai/suggest.
SPOONACULAR_API_KEY=
